# Neon pooled connection string (runtime). Local dev uses the `dev` branch.
DATABASE_URL=

# Neon direct (non-pooled) connection string. Used for migrations only.
DIRECT_URL=

# Long random string, different per environment (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=

# Backend's own base URL. Locally: http://localhost:3000
BETTER_AUTH_URL=

# Google OAuth Web client, from the Account Setup Guide.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only this email may sign in.
ALLOWED_EMAIL=
