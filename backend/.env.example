#
# Copy set to .env and fill in values
#
# THESE ARE USED FOR LOCAL DEVELOPMENT ONLY. 
# Production values are set as environment variables on the deployment server (Vercel), 
# not in a file.

# Neon pooled connection string. Used by the running backend (Prisma client).
# Local dev uses the `dev` branch.
DATABASE_URL=

# Neon direct (non-pooled) connection string. Used for migrations only.
DIRECT_URL=

# Secret Better Auth uses to sign and encrypt auth data such as sessions.
# Long random string, different per environment (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=

# This backend's own address, as the phone reaches it. Read by Better Auth as its baseURL.
# Local: your PC's LAN IP (ipconfig, IPv4), e.g. http://192.168.1.50:3000. Not the phone's IP.
# Must be the same value as EXPO_PUBLIC_BACKEND_URL in app/.env.local.
BETTER_AUTH_URL=

  # Google OAuth Web client, from the Account Setup Guide. Same Web client as
  # EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in the app. Used to verify the Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only this email may sign in.
ALLOWED_EMAIL=
