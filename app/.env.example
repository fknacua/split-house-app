# Copy to .env.local (never committed) and fill in the values.
# EXPO_PUBLIC_* values are baked in at bundle time: restart Metro with
# `npx expo start --dev-client -c` after changing them.

# Address of the backend this app sends its requests to. The app throws at launch if it is missing.
# Local backend: your PC's LAN IP (ipconfig, IPv4), e.g. http://192.168.1.50:3000. Not the phone's IP.
#   Must be the same value as BETTER_AUTH_URL in backend/.env.
# Deployed backend: the https:// address of the Vercel project.
EXPO_PUBLIC_BACKEND_URL=

# Google OAuth Web client ID (not the Android one). Used by the sign-in screen.
# Same Web client as GOOGLE_CLIENT_ID in backend/.env.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
